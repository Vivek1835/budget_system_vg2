# ---- Database on the same computer (what you use now) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=budget_app
DB_PASSWORD=put-your-database-password-here
DB_NAME=smartbudget
DB_SSL_CA=

# ---- Online database (TiDB Cloud). Use these lines instead of the ones above. ----
# DB_HOST=gateway01.xxxx.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=the-password-from-tidb-cloud
# DB_NAME=smartbudget
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SECRET_KEY=put-a-long-random-text-here